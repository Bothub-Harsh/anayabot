# ==============================================================================
# LUDO ARENA — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to .env for local development or configure in Render Dashboard.
# NEVER commit your actual .env file or production secrets to Git!

# ------------------------------------------------------------------------------
# 1. BACKEND WEB SERVICE CONFIGURATION (Render Web Service)
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=10000

# MongoDB Atlas Connection String
# Format: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/ludo_arena?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://ludo_admin:PASSWORD@cluster0.xxxxx.mongodb.net/ludo_arena?retryWrites=true&w=majority

# Frontend Client URL (Deployed Render Static Site domain, used for CORS)
# Example: https://ludo-arena-client.onrender.com
CLIENT_URL=https://your-frontend.onrender.com

# Public HTTPS URL of the Frontend (used for Telegram Mini App buttons)
# Example: https://ludo-arena-client.onrender.com
WEB_APP_URL=https://your-frontend.onrender.com

# Telegram Bot Token (obtained from @BotFather via /newbot)
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# Telegram Bot Username (without @ symbol, e.g. AnayaReplyBot)
TELEGRAM_BOT_USERNAME=AnayaReplyBot

# Telegram Mini App Short Name (configured in @BotFather via /newapp, e.g. ludo)
TELEGRAM_MINI_APP_SHORT_NAME=ludo

# Authorized Admin Telegram Numeric User IDs (comma-separated numbers)
ADMIN_TELEGRAM_IDS=123456789,987654321

# ------------------------------------------------------------------------------
# 2. FRONTEND STATIC SITE CONFIGURATION (Render Static Site / Vite)
# ------------------------------------------------------------------------------
# Public URL of the Deployed Backend Service (must have VITE_ prefix for Vite)
# Example: https://ludo-arena-server.onrender.com
VITE_SERVER_URL=https://your-backend.onrender.com
